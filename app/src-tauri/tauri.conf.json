{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DramFlow剪映导入插件",
  "version": "0.1.0",
  "identifier": "com.yingdraft.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DramFlow剪映导入插件",
        "width": 1180,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
